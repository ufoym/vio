{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Host compiler, Release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "inherits": "native",
      "displayName": "Host compiler, Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64",
      "inherits": "native",
      "displayName": "macOS x86-64 (runs under Rosetta; ROSETTA_ADVERTISE_AVX=1 for AVX2)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "a32",
      "inherits": "native",
      "displayName": "AArch64 host using the AArch32 NEON code paths (testing)",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-DVIO_NEON_FORCE_A32"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "x64",
      "configurePreset": "x64"
    },
    {
      "name": "a32",
      "configurePreset": "a32"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "x64",
      "configurePreset": "x64",
      "environment": {
        "ROSETTA_ADVERTISE_AVX": "1"
      }
    },
    {
      "name": "a32",
      "configurePreset": "a32"
    }
  ]
}
